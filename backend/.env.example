# OncoPrecision Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEMO_MODE=true

# Database Configuration (SQLite default for zero-friction local run; PostgreSQL-compatible)
DATABASE_URL=sqlite:///./oncoprecision.db

# Optional External GenAI API (Gemini API for Stage 5 scenario expansion)
# Note: Platform works 100% offline with deterministic medical simulation in DEMO_MODE
GEMINI_API_KEY=

# Local Model Directory
MODEL_PATH=./models
LOG_LEVEL=INFO
